<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RegOS.Submission.Domain\RegOS.Submission.Domain.csproj" />
    <ProjectReference Include="..\..\Persistence\RegOS.Persistence\RegOS.Persistence.csproj" />
    <ProjectReference Include="..\..\Storage\RegOS.Storage\RegOS.Storage.csproj" />
  </ItemGroup>

  <!--
    Every eCTD package ships its DTDs inside util/dtd/ (ICH Appendix 4, rows
    371-376), so these are build inputs rather than reference material.

    Linked out of docs/evidence/ rather than copied beside the code, and
    deliberately: a copy would drift from the file the evidence directory pins,
    and then the DTD a package carries would stop being the DTD the Level 2a
    claim was checked against. One file, two readers.
  -->
  <ItemGroup>
    <EmbeddedResource
      Include="..\..\..\docs\evidence\EPIC-007a\spec\ich-ectd-3-2.dtd"
      LogicalName="RegOS.Submission.Application.Generation.ich-ectd-3-2.dtd" />
    <EmbeddedResource
      Include="..\..\..\docs\evidence\EPIC-007a\spec\us-regional-v3-3.dtd"
      LogicalName="RegOS.Submission.Application.Generation.us-regional-v3-3.dtd" />
    <EmbeddedResource
      Include="..\..\..\docs\evidence\EPIC-019\spec\ich-stf-v2-2.dtd"
      LogicalName="RegOS.Submission.Application.Generation.ich-stf-v2-2.dtd" />
    <!--
      The stylesheet and the vocabulary it reads travel together: the stylesheet
      resolves document('valid-values.xml') by a relative path, so a util/style/
      holding one of them checks nothing (E34).
    -->
    <EmbeddedResource
      Include="..\..\..\docs\evidence\EPIC-019\spec\ich-stf-stylesheet-2-3.xsl"
      LogicalName="RegOS.Submission.Application.Generation.ich-stf-stylesheet-2-3.xsl" />
    <EmbeddedResource
      Include="..\..\..\docs\evidence\EPIC-019\spec\valid-values.xml"
      LogicalName="RegOS.Submission.Application.Generation.valid-values.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
